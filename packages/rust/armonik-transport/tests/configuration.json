[
  {
    "name": "no source is every option at its default",
    "sources": [],
    "options": {}
  },
  {
    "name": "a document is read as it is written",
    "sources": [
      { "document": { "Endpoint": "http://server.test:5001", "MemoryCeiling": { "SoftMiB": 1048576 } } }
    ],
    "options": { "Endpoint": "http://server.test:5001", "MemoryCeiling": { "SoftMiB": 1048576 } }
  },
  {
    "name": "a later source wins over an earlier one, option by option",
    "files": {
      "base.json": "{\"ArmoniK\":{\"Client\":{\"Grpc\":{\"Endpoint\":\"http://base.test:1\",\"ChannelDefaults\":{\"Http2\":{\"SimultaneousCallsPerConnection\":{\"Limit\":4}},\"Grpc\":{\"UserAgent\":\"base\"}}}}},\"Serilog\":{\"Level\":\"Debug\"}}"
    },
    "sources": [
      { "file": "base.json" },
      { "document": { "ChannelDefaults": { "Grpc": { "UserAgent": "over" } } } }
    ],
    "options": {
      "Endpoint": "http://base.test:1",
      "ChannelDefaults": {
        "Http2": { "SimultaneousCallsPerConnection": { "Limit": 4 } },
        "Grpc": { "UserAgent": "over" }
      }
    }
  },
  {
    "name": "YAML and TOML are read as JSON is",
    "files": {
      "base.yaml": "ArmoniK:\n  Client:\n    Grpc:\n      Endpoint: https://yaml.test:2\n      MemoryCeiling:\n        SoftMiB: 1024\n      ChannelDefaults:\n        Transport:\n          Tls:\n            ServerCertificates: None\n",
      "over.toml": "[ArmoniK.Client.Grpc.MemoryCeiling]\nHardMiB = 2048\n\n[ArmoniK.Client.Grpc.ChannelDefaults.Http2.KeepAlive.Ping]\nIntervalSeconds = 10\nWhileIdle = true\nTimeoutSeconds = 2.5\n"
    },
    "sources": [
      { "file": "base.yaml" },
      { "file": "over.toml" }
    ],
    "options": {
      "Endpoint": "https://yaml.test:2",
      "MemoryCeiling": { "SoftMiB": 1024, "HardMiB": 2048 },
      "ChannelDefaults": {
        "Transport": { "Tls": { "ServerCertificates": "None" } },
        "Http2": { "KeepAlive": { "Ping": { "IntervalSeconds": 10, "WhileIdle": true, "TimeoutSeconds": 2.5 } } }
      }
    }
  },
  {
    "name": "with no prefix a file's document is the whole file, its host's sections logged",
