<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <IsPackable>false</IsPackable>
    <LangVersion>10</LangVersion>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Grpc.AspNetCore" Version="2.71.0" />
    <PackageReference Include="Grpc.Tools" Version="2.71.0" PrivateAssets="All" />
    <PackageReference Include="NUnit" Version="3.14.0" />
    <PackageReference Include="NUnit3TestAdapter" Version="4.6.0" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.13.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\ArmoniK.Api.Client.RustGrpcChannel\ArmoniK.Api.Client.RustGrpcChannel.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Protobuf Include="echo.proto" GrpcServices="Both" />
  </ItemGroup>

  <!-- The engine the binding's own build produced, beside this assembly: resolved from PATH it
       could be a stale one somewhere else that answers. -->
  <Target Name="CopyNativeEngineForTests" AfterTargets="Build">
    <ItemGroup>
      <BuiltEngine Include="$(MSBuildThisFileDirectory)..\..\rust\target\$(Configuration.ToLower())\*armonik_transport_ffi.dll" />
      <BuiltEngine Include="$(MSBuildThisFileDirectory)..\..\rust\target\$(Configuration.ToLower())\*armonik_transport_ffi.so" />
      <BuiltEngine Include="$(MSBuildThisFileDirectory)..\..\rust\target\$(Configuration.ToLower())\*armonik_transport_ffi.dylib" />
    </ItemGroup>
    <Error Condition="'@(BuiltEngine)' == ''"
           Text="no native engine under packages/rust/target/$(Configuration.ToLower()); the binding's build produces it" />
    <Copy SourceFiles="@(BuiltEngine)" DestinationFolder="$(OutDir)" SkipUnchangedFiles="true" />
  </Target>

</Project>
