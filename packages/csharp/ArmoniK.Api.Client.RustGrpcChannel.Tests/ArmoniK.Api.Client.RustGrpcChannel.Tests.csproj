<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <IsPackable>false</IsPackable>
    <LangVersion>10</LangVersion>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Grpc.AspNetCore" Version="2.71.0" />
    <PackageReference Include="Grpc.Tools" Version="2.71.0" PrivateAssets="All" />
    <PackageReference Include="NUnit" Version="3.14.0" />
    <PackageReference Include="NUnit3TestAdapter" Version="4.6.0" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.13.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\ArmoniK.Api.Client.RustGrpcChannel\ArmoniK.Api.Client.RustGrpcChannel.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Protobuf Include="echo.proto" GrpcServices="Both" />
  </ItemGroup>

  <!-- The engine the binding's own build produced, for the architecture this test host runs as,
       beside this assembly: resolved from PATH it could be a stale one somewhere else that
       answers. Naming a target explicitly makes cargo write under target/[triple]/, so the path
       carries the triple now. -->
  <Target Name="CopyNativeEngineForTests" AfterTargets="Build">
    <PropertyGroup>
      <TestEngineTriple Condition="'$(NETCoreSdkRuntimeIdentifier)' == 'win-x64'">x86_64-pc-windows-msvc</TestEngineTriple>
      <TestEngineTriple Condition="'$(NETCoreSdkRuntimeIdentifier)' == 'win-x86'">i686-pc-windows-msvc</TestEngineTriple>
      <TestEngineTriple Condition="'$(NETCoreSdkRuntimeIdentifier)' == 'win-arm64'">aarch64-pc-windows-msvc</TestEngineTriple>
      <TestEngineTriple Condition="'$(NETCoreSdkRuntimeIdentifier)' == 'linux-x64'">x86_64-unknown-linux-gnu</TestEngineTriple>
      <TestEngineTriple Condition="'$(NETCoreSdkRuntimeIdentifier)' == 'linux-arm64'">aarch64-unknown-linux-gnu</TestEngineTriple>
      <TestEngineTriple Condition="'$(NETCoreSdkRuntimeIdentifier)' == 'osx-x64'">x86_64-apple-darwin</TestEngineTriple>
      <TestEngineTriple Condition="'$(NETCoreSdkRuntimeIdentifier)' == 'osx-arm64'">aarch64-apple-darwin</TestEngineTriple>
    </PropertyGroup>
    <ItemGroup>
      <BuiltEngine Include="$(MSBuildThisFileDirectory)..\..\rust\target\$(TestEngineTriple)\$(Configuration.ToLower())\*armonik_transport_ffi.dll" />
      <BuiltEngine Include="$(MSBuildThisFileDirectory)..\..\rust\target\$(TestEngineTriple)\$(Configuration.ToLower())\*armonik_transport_ffi.so" />
      <BuiltEngine Include="$(MSBuildThisFileDirectory)..\..\rust\target\$(TestEngineTriple)\$(Configuration.ToLower())\*armonik_transport_ffi.dylib" />
    </ItemGroup>
    <Error Condition="'$(TestEngineTriple)' == ''"
           Text="no Rust target is mapped for $(NETCoreSdkRuntimeIdentifier)" />
    <Error Condition="'@(BuiltEngine)' == ''"
           Text="no native engine under packages/rust/target/$(TestEngineTriple)/$(Configuration.ToLower()); the binding's build produces it" />
    <Copy SourceFiles="@(BuiltEngine)" DestinationFolder="$(OutDir)" SkipUnchangedFiles="true" />
  </Target>

</Project>
