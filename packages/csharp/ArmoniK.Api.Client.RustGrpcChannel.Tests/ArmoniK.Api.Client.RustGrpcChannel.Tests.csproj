<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- The binding ships netstandard2.0, net8.0, net10.0 and, built by an SDK 11, net11.0. A
         .NET Framework consumer resolves to the netstandard2.0 half, so that half gets its own
         hosts. -->
    <TargetFrameworks>net4.7;net4.8;net8.0;net10.0</TargetFrameworks>
    <!-- net11.0 is built only by an SDK 11 or later; CI installs none. -->
    <TargetFrameworks Condition="$([MSBuild]::VersionGreaterThanOrEquals('$(NETCoreSdkVersion)', '11.0'))">$(TargetFrameworks);net11.0</TargetFrameworks>
    <IsPackable>false</IsPackable>
    <PackageVersion>3.29.2</PackageVersion>
    <Version>3.29.2</Version>
    <LangVersion>10</LangVersion>
    <Nullable>enable</Nullable>
    <!-- The generated declarations take pointers, and these tests build what the engine hands
         over. -->
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <!-- The engine is a native library of one architecture, so the host must not silently be of
         another: AnyCPU on a 64-bit machine would run 64-bit and load the x64 engine, which is
         right, but only by accident. -->
    <PlatformTarget Condition="'$(PlatformTarget)' == ''">x64</PlatformTarget>
    <Prefer32Bit>false</Prefer32Bit>
    <!-- The same key as the binding, because a strong-named assembly names its friends by key. -->
    <SignAssembly>True</SignAssembly>
    <AssemblyOriginatorKeyFile>../kp.snk</AssemblyOriginatorKeyFile>

  </PropertyGroup>

  <ItemGroup Condition="'$(TargetFrameworkIdentifier)' == '.NETFramework'">
    <!-- So a 4.7 or 4.8 host builds without that targeting pack installed, which is what lets
         this run on a machine that only has the .NET SDK. -->
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies" Version="1.0.3" PrivateAssets="All" />
  </ItemGroup>

  <ItemGroup>
    <!-- The generated client needs these two and nothing else: the server half of the contract
         lives in another process, so Grpc.AspNetCore does not belong here. The version matches
         what ArmoniK.Api.Common resolves, since this project now references the real client. -->
    <PackageReference Include="Google.Protobuf" Version="3.32.0" />
    <PackageReference Include="Grpc.Tools" Version="2.71.0" PrivateAssets="All" />
    <!-- GrpcClient is bound from a configuration, and which keys it held is what the tests read. -->
    <PackageReference Include="Microsoft.Extensions.Configuration" Version="8.0.0" />
    <PackageReference Include="Microsoft.Extensions.Configuration.Binder" Version="8.0.2" />
    <PackageReference Include="NUnit" Version="3.14.0" />
    <PackageReference Include="NUnit3TestAdapter" Version="4.6.0" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.13.0" />
  </ItemGroup>

  <ItemGroup>
    <!-- The binding is pure managed and has no architecture; only the engine it loads does, and
         that is chosen by NativeEngineRids. Left to inherit PlatformTarget it would be rebuilt
         per architecture, and its stale deps.json then breaks the next one. -->
    <ProjectReference Include="..\ArmoniK.Api.Client.RustGrpcChannel\ArmoniK.Api.Client.RustGrpcChannel.csproj"
                      UndefineProperties="PlatformTarget;Prefer32Bit" />
    <!-- The real ArmoniK client, for the one test that proves the generated stubs work over this
         invoker rather than over grpc-dotnet's. Pure managed, so it has no architecture either. -->
    <ProjectReference Include="..\ArmoniK.Api.Client\ArmoniK.Api.Client.csproj"
                      UndefineProperties="PlatformTarget;Prefer32Bit" />
    <!-- Built but not referenced: it is a net8.0 process these tests start, not a library they
         link, and a net4.7 host could not load it anyway. -->
    <ProjectReference Include="..\ArmoniK.Api.Mock\ArmoniK.Api.Mock.csproj"
                      ReferenceOutputAssembly="false"
                      SetTargetFramework="TargetFramework=net8.0"
                      UndefineProperties="PlatformTarget;Prefer32Bit" />
    <ProjectReference Include="..\ArmoniK.Api.Client.RustGrpcChannel.TestServer\ArmoniK.Api.Client.RustGrpcChannel.TestServer.csproj"
                      ReferenceOutputAssembly="false"
                      SetTargetFramework="TargetFramework=net8.0"
                      UndefineProperties="PlatformTarget;Prefer32Bit" />
  </ItemGroup>

  <ItemGroup>
    <Protobuf Include="..\ArmoniK.Api.Client.RustGrpcChannel.TestServer\echo.proto" GrpcServices="Client" />
  </ItemGroup>

  <!-- Where that process lives, handed to the fixture rather than rediscovered at run time: the
       tests run from three different framework directories and the server from only one.

       Forward slashes, because these reach .NET as an attribute value and not as a path MSBuild
       normalises: on Linux a backslash is an ordinary filename character, so the whole tail would
       be one name that `File.Exists` never finds. -->
  <ItemGroup>
    <AssemblyMetadata Include="TestServerAssembly"
                      Value="$(MSBuildThisFileDirectory)../ArmoniK.Api.Client.RustGrpcChannel.TestServer/bin/$(Configuration)/net8.0/ArmoniK.Api.Client.RustGrpcChannel.TestServer.dll" />
    <AssemblyMetadata Include="MockServerAssembly"
                      Value="$(MSBuildThisFileDirectory)../ArmoniK.Api.Mock/bin/$(Configuration)/net8.0/ArmoniK.Api.Mock.dll" />
  </ItemGroup>

  <!-- An architecture switch in one tree does not rebuild on its own: MSBuild's up-to-date check
       ignores a property change, so the previous architecture's assembly and engine survive and
       the failure arrives later as a refused test run. Said here instead, where it is actionable.
       CI builds each architecture in its own job, so it never meets this. -->
  <Target Name="RefuseAMixedArchitectureTree" AfterTargets="CopyFilesToOutputDirectory">
    <PropertyGroup>
      <ArchitectureStamp>$(IntermediateOutputPath)built-as-$(PlatformTarget).stamp</ArchitectureStamp>
    </PropertyGroup>
    <ItemGroup>
      <OtherArchitectureStamp Include="$(IntermediateOutputPath)built-as-*.stamp"
                              Exclude="$(ArchitectureStamp)" />
    </ItemGroup>
    <Error Condition="'@(OtherArchitectureStamp)' != ''"
           Text="this tree was last built as @(OtherArchitectureStamp->'%(Filename)'), not $(PlatformTarget); run `dotnet clean` or build with --no-incremental before switching architecture" />
    <Touch Files="$(ArchitectureStamp)" AlwaysCreate="true" />
    <!-- Declared as an output, or `dotnet clean` leaves it behind and the advice above is a
         dead end: Clean removes what the build recorded writing and nothing else. -->
    <ItemGroup>
      <FileWrites Include="$(ArchitectureStamp)" />
    </ItemGroup>
  </Target>

  <!-- The engine the binding's own build produced, for the architecture this test host runs as,
       beside this assembly: resolved from PATH it could be a stale one somewhere else that
       answers. Naming a target makes cargo write under target/[triple]/, so the path carries the
       triple now. -->
  <Import Project="$(MSBuildThisFileDirectory)..\RustTargets.props" />

  <Target Name="CopyNativeEngineForTests" AfterTargets="CopyFilesToOutputDirectory"
          Condition="'$(SkipNativeEngine)' != 'true'">
    <!-- The one row of the shared table this host wants, so an architecture is added in one
         place instead of in two lists keyed differently. -->
    <ItemGroup>
      <HostRustTarget Include="@(RustTarget->WithMetadataValue('Os', '$(RustHostOs)')->WithMetadataValue('Arch', '$(PlatformTarget)')->WithMetadataValue('Libc', '$(RustHostLibc)'))" />
    </ItemGroup>
    <PropertyGroup>
      <TestEngineTriple>@(HostRustTarget->'%(Triple)')</TestEngineTriple>
      <TestEngineLibrary>@(HostRustTarget->'%(Library)')</TestEngineLibrary>
      <BuiltEngineDir>$(RustWorkspace)target\$(TestEngineTriple)\$(RustProfile)\</BuiltEngineDir>
    </PropertyGroup>
    <!-- Ahead of the item group, which would otherwise glob a directory named by nothing. -->
    <Error Condition="'$(TestEngineTriple)' == ''"
           Text="RustTargets.props maps no Rust target to $(RustHostOs)/$(PlatformTarget)/$(RustHostLibc)" />
    <ItemGroup>
      <BuiltEngine Include="$(BuiltEngineDir)$(TestEngineLibrary)" />
    </ItemGroup>
    <Error Condition="'@(BuiltEngine)' == ''"
           Text="no $(TestEngineLibrary) in $(BuiltEngineDir); build the binding with -p:NativeEngineRids for this architecture" />
    <!-- .NET Framework as its package lays it out: in a folder named for the architecture, which the
         binding loads by its path. A copy beside the assembly would be what the loader finds first,
         whichever build the binding was told to load. -->
    <Copy Condition="'$(TargetFrameworkIdentifier)' != '.NETFramework'"
          SourceFiles="@(BuiltEngine)" DestinationFolder="$(OutDir)" SkipUnchangedFiles="true" />
    <Copy Condition="'$(TargetFrameworkIdentifier)' == '.NETFramework'"
          SourceFiles="@(BuiltEngine)" DestinationFolder="$(OutDir)$(PlatformTarget)\" SkipUnchangedFiles="true" />
  </Target>

  <!-- The netstandard2.0 build of the binding, beside a .NET host that references the build for its
       own framework, so that a test can load the one a .NET Framework consumer gets and run it on a
       .NET runtime. -->
  <Target Name="CopyNetStandardBindingForTests" AfterTargets="CopyFilesToOutputDirectory"
          Condition="'$(TargetFrameworkIdentifier)' == '.NETCoreApp'">
    <MSBuild Projects="..\ArmoniK.Api.Client.RustGrpcChannel\ArmoniK.Api.Client.RustGrpcChannel.csproj"
             Properties="TargetFramework=netstandard2.0"
             RemoveProperties="PlatformTarget;Prefer32Bit"
             Targets="Build">
      <Output TaskParameter="TargetOutputs" ItemName="NetStandardBinding" />
    </MSBuild>
    <Copy SourceFiles="@(NetStandardBinding)" DestinationFolder="$(OutDir)netstandard2.0\" SkipUnchangedFiles="true" />
  </Target>

  <!-- The build with the counters, where the package puts it: runtimes/[rid]/metrics for .NET, and
       [architecture]/metrics for .NET Framework. A run selects one of the two builds with
       ARMONIK_TEST_NATIVE=metrics, since a process loads a library once. -->
  <Target Name="CopyNativeMetricsEngineForTests" AfterTargets="CopyNativeEngineForTests"
          Condition="'$(SkipNativeEngine)' != 'true' AND '$(NativeEngineMetrics)' != 'false'">
    <PropertyGroup>
      <TestEngineRid>@(HostRustTarget)</TestEngineRid>
    </PropertyGroup>
    <ItemGroup>
      <BuiltMetricsEngine Include="$(RustWorkspace)target\metrics\$(TestEngineTriple)\$(RustProfile)\$(TestEngineLibrary)" />
    </ItemGroup>
    <Error Condition="'@(BuiltMetricsEngine)' == '' OR !Exists('%(BuiltMetricsEngine.FullPath)')"
           Text="no metrics build of $(TestEngineLibrary) in $(RustWorkspace)target\metrics\$(TestEngineTriple)\$(RustProfile); build the binding with -p:NativeEngineRids for this architecture" />
    <Copy SourceFiles="@(BuiltMetricsEngine)" DestinationFolder="$(OutDir)runtimes\$(TestEngineRid)\metrics\" SkipUnchangedFiles="true" />
    <Copy Condition="'$(TargetFrameworkIdentifier)' == '.NETFramework'"
          SourceFiles="@(BuiltMetricsEngine)" DestinationFolder="$(OutDir)$(PlatformTarget)\metrics\" SkipUnchangedFiles="true" />
  </Target>

</Project>
