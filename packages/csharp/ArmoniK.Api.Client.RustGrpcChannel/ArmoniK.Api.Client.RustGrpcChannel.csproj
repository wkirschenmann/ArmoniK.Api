<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFrameworks>netstandard2.0;net8.0</TargetFrameworks>
    <Company>ANEO</Company>
    <Copyright>Copyright (C) ANEO, 2021-2022</Copyright>
    <PackageLicenseExpression>Apache-2.0</PackageLicenseExpression>
    <PackageOutputPath>../publish</PackageOutputPath>
    <IsPackable>true</IsPackable>
    <LangVersion>10</LangVersion>
    <Nullable>enable</Nullable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <SignAssembly>True</SignAssembly>
    <AssemblyOriginatorKeyFile>../kp.snk</AssemblyOriginatorKeyFile>
    <PackageVersion>3.29.2</PackageVersion>
    <Version>3.29.2</Version>
    <GenerateDocumentationFile>True</GenerateDocumentationFile>
    <GeneratePackageOnBuild>True</GeneratePackageOnBuild>
    <PackageRequireLicenseAcceptance>True</PackageRequireLicenseAcceptance>
    <Optimize>true</Optimize>
  </PropertyGroup>

  <PropertyGroup Condition=" '$(Configuration)' == 'Debug' ">
    <DebugType>Embedded</DebugType>
    <IncludeSymbols>true</IncludeSymbols>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Grpc.Core.Api" Version="2.71.0" />
  </ItemGroup>

  <ItemGroup Condition="'$(TargetFramework)' == 'netstandard2.0'">
    <PackageReference Include="System.Text.Json" Version="8.0.5" />
  </ItemGroup>

  <ItemGroup Condition="'$(TargetFramework)' == 'netstandard2.0'">
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies" Version="1.0.3" PrivateAssets="All" />
    <!-- IAsyncDisposable and ValueTask: a channel's disposal is asynchronous because the last
         one released awaits the runtime's destroy, and neither type is in netstandard2.0. -->
    <PackageReference Include="Microsoft.Bcl.AsyncInterfaces" Version="8.0.0" />
  </ItemGroup>

  <!-- ChannelOptions.g.cs is generated from the engine's own option schema and committed, so a
       reader of this assembly sees the vocabulary without running anything. Built but not
       referenced: it is a net8.0 tool this build runs, not a library the binding links, and
       OutputItemType is what hands over where it landed. -->
  <ItemGroup>
    <ProjectReference Include="..\tools\ArmoniK.Api.Client.RustGrpcChannel.OptionsGenerator\ArmoniK.Api.Client.RustGrpcChannel.OptionsGenerator.csproj"
                      ReferenceOutputAssembly="false"
                      OutputItemType="OptionsGeneratorTool"
                      SetTargetFramework="TargetFramework=net8.0"
                      UndefineProperties="PlatformTarget;Prefer32Bit" />
  </ItemGroup>

  <PropertyGroup>
    <!-- Spelled out rather than taken from RustTargets.props, which this file imports further
         down: a property is worth what is defined above it. Normalised because this path is named
         in a failure message, and `a/../b` is one the reader has to resolve first. Forward
         slashes, because a backslash is an ordinary filename character on Linux. -->
    <OptionsSchema>$([System.IO.Path]::GetFullPath('$(MSBuildThisFileDirectory)../../rust/armonik-transport/options.schema.json'))</OptionsSchema>
    <GeneratedOptions>$(MSBuildThisFileDirectory)ChannelOptions.g.cs</GeneratedOptions>
  </PropertyGroup>

  <!-- A committed generated file is one that can be stale, and a stale one is an option the
       engine reads and no caller can set - or a bound the engine enforces and this assembly does
       not. Compared rather than rewritten, so a build never edits the tree it is building.
       After ResolveProjectReferences and not BeforeBuild, which is early enough that the tool
       has not been built and OptionsGeneratorTool names nothing.

       The tool itself is an input, or a change to what it renders would not re-run the check:
       edit the emitter alone and both declared files stay older than the stamp. Its assembly
       rather than its sources, because that is what a build of it produces. -->
  <Target Name="CheckGeneratedOptionsMatchTheSchema" AfterTargets="ResolveProjectReferences"
          Inputs="$(OptionsSchema);$(GeneratedOptions);@(OptionsGeneratorTool)"
          Outputs="$(IntermediateOutputPath)options-checked.stamp">
    <Exec Command="dotnet exec &quot;@(OptionsGeneratorTool)&quot; --schema &quot;$(OptionsSchema)&quot; --output &quot;$(GeneratedOptions)&quot; --check"
          ContinueOnError="true">
      <Output TaskParameter="ExitCode" PropertyName="OptionsCheckExitCode" />
    </Exec>
    <Error Condition="'$(OptionsCheckExitCode)' != '0'"
           Text="ChannelOptions.g.cs is not what $(OptionsSchema) renders (exit $(OptionsCheckExitCode)). Write it again with `dotnet run --project packages/csharp/tools/ArmoniK.Api.Client.RustGrpcChannel.OptionsGenerator -- --schema packages/rust/armonik-transport/options.schema.json --output packages/csharp/ArmoniK.Api.Client.RustGrpcChannel/ChannelOptions.g.cs`." />
    <Touch Files="$(IntermediateOutputPath)options-checked.stamp" AlwaysCreate="true" />
    <!-- Or `dotnet clean` leaves the stamp and the next build skips the check. -->
    <ItemGroup>
      <FileWrites Include="$(IntermediateOutputPath)options-checked.stamp" />
    </ItemGroup>
  </Target>

  <!-- The engine this binds to is a Rust cdylib in the same repository, and a binding without it
       does nothing, so building one builds the other. Cargo's profile directories are named after
       the .NET configurations, which is why the same lowercased name serves both. -->
  <PropertyGroup>
    <!-- The host alone by default: the other architectures need cross toolchains this machine may
         not have, and a routine build should not spend minutes on engines nobody is about to run.
         CI and packing pass the whole list. -->
    <NativeEngineRids Condition="'$(NativeEngineRids)' == ''">$(NETCoreSdkRuntimeIdentifier)</NativeEngineRids>
  </PropertyGroup>

  <Import Project="$(MSBuildThisFileDirectory)..\RustTargets.props" />

  <!-- What the package carries. .NET reads runtimes/[rid]/native itself; the targets file is for
       .NET Framework, which does not. Built in a target rather than declared, because only the
       architectures actually built should be packed and an item condition may not ask that of
       its own identity. A package made without the whole matrix then says so by omission rather
       than by a broken entry. -->
  <Target Name="AddNativeEngineToPackage" BeforeTargets="_GetPackageFiles">
    <ItemGroup>
      <NativeEngineAsset Include="@(RustTarget->'$(RustWorkspace)target\%(Triple)\$(RustProfile)\%(Library)')"
                         Rid="%(RustTarget.Identity)" />
      <None Include="@(NativeEngineAsset)"
            Condition="Exists('%(NativeEngineAsset.Identity)')"
            Pack="true"
            PackagePath="runtimes\%(NativeEngineAsset.Rid)\native\"
            Visible="false" />
      <None Include="build\ArmoniK.Api.Client.RustGrpcChannel.targets"
            Pack="true"
            PackagePath="build\;buildTransitive\"
            Visible="false" />
    </ItemGroup>
  </Target>

  <Target Name="BuildNativeEngine" BeforeTargets="BeforeBuild"
          Outputs="%(RustTarget.Identity)">
    <!-- Batched over the requested runtime identifiers, so `Outputs` above is what makes MSBuild
         run this once per architecture rather than once with all of them. -->
    <PropertyGroup>
      <RustTargetWanted>$(NativeEngineRids.Contains('%(RustTarget.Identity)'))</RustTargetWanted>
    </PropertyGroup>

    <Exec Condition="'$(RustTargetWanted)' == 'true'"
          Command="cargo build -p armonik-transport-ffi --target %(RustTarget.Triple) $(RustProfileFlag)"
          WorkingDirectory="$(RustWorkspace)"
          ContinueOnError="true">
      <Output TaskParameter="ExitCode" PropertyName="CargoExitCode" />
    </Exec>
    <!-- On Windows cargo needs cl.exe and link.exe, which only a Visual Studio environment puts on
         PATH, and a 32-bit engine needs the x64_x86 one rather than the x64 one, so a plain shell
         fails here rather than in anything a reader would connect to the C toolchain. -->
    <Error Condition="'$(RustTargetWanted)' == 'true' AND '$(CargoExitCode)' != '0'"
           Text="cargo build -p armonik-transport-ffi --target %(RustTarget.Triple) $(RustProfileFlag) failed in $(RustWorkspace) (exit $(CargoExitCode)). On Windows this needs a Visual Studio environment: vcvars64.bat for x64, vcvarsall.bat x64_x86 for x86." />
  </Target>

</Project>
