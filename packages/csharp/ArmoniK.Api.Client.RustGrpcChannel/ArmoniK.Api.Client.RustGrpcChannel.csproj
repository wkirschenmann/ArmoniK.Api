<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFrameworks>netstandard2.0;net8.0</TargetFrameworks>
    <Company>ANEO</Company>
    <Copyright>Copyright (C) ANEO, 2021-2022</Copyright>
    <PackageLicenseExpression>Apache-2.0</PackageLicenseExpression>
    <PackageOutputPath>../publish</PackageOutputPath>
    <IsPackable>true</IsPackable>
    <LangVersion>10</LangVersion>
    <Nullable>enable</Nullable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <SignAssembly>True</SignAssembly>
    <AssemblyOriginatorKeyFile>../kp.snk</AssemblyOriginatorKeyFile>
    <PackageVersion>3.29.2</PackageVersion>
    <Version>3.29.2</Version>
    <GenerateDocumentationFile>True</GenerateDocumentationFile>
    <GeneratePackageOnBuild>True</GeneratePackageOnBuild>
    <PackageRequireLicenseAcceptance>True</PackageRequireLicenseAcceptance>
    <Optimize>true</Optimize>
  </PropertyGroup>

  <PropertyGroup Condition=" '$(Configuration)' == 'Debug' ">
    <DebugType>Embedded</DebugType>
    <IncludeSymbols>true</IncludeSymbols>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Grpc.Core.Api" Version="2.71.0" />
  </ItemGroup>

  <ItemGroup Condition="'$(TargetFramework)' == 'netstandard2.0'">
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies" Version="1.0.3" PrivateAssets="All" />
    <!-- IAsyncDisposable and ValueTask: a channel's disposal is asynchronous because the last
         one released awaits the runtime's destroy, and neither type is in netstandard2.0. -->
    <PackageReference Include="Microsoft.Bcl.AsyncInterfaces" Version="8.0.0" />
  </ItemGroup>

  <!-- The engine this binds to is a Rust cdylib in the same repository, and a binding without it
       does nothing, so building one builds the other. Cargo's profile directories are named
       after the .NET configurations, which is why the same lowercased name serves both. -->
  <PropertyGroup>
    <RustWorkspace>$(MSBuildThisFileDirectory)..\..\rust\</RustWorkspace>
    <RustProfile>$(Configuration.ToLower())</RustProfile>
    <RustProfileFlag Condition="'$(RustProfile)' == 'release'">--release</RustProfileFlag>
  </PropertyGroup>

  <Target Name="BuildNativeEngine" BeforeTargets="BeforeBuild">
    <Exec Command="cargo build -p armonik-transport-ffi $(RustProfileFlag)"
          WorkingDirectory="$(RustWorkspace)"
          ContinueOnError="true">
      <Output TaskParameter="ExitCode" PropertyName="CargoExitCode" />
    </Exec>
    <!-- On Windows cargo needs cl.exe and link.exe, which only a Visual Studio environment puts
         on PATH, so a plain shell fails here rather than in anything a reader would connect to
         the C toolchain. -->
    <Error Condition="'$(CargoExitCode)' != '0'"
           Text="cargo build -p armonik-transport-ffi $(RustProfileFlag) failed in $(RustWorkspace) (exit $(CargoExitCode)). On Windows this build needs a Visual Studio environment - run it from a Developer Command Prompt, or after vcvars64.bat." />
  </Target>

</Project>
