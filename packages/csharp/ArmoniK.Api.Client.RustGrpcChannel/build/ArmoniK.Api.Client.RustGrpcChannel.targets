<Project>

  <!--
    Imported into the consumer's build, which is why its conditions can ask what the consumer is.

    .NET resolves a native asset by runtime identifier out of runtimes/<rid>/native, so it needs
    nothing from here. .NET Framework has no such mechanism at all: no deps.json, no runtime
    identifier, just the Win32 search order. So every Windows engine the package carries is copied
    beside the application, in a folder named for its architecture - win-x64 into x64 - and the
    binding's own static constructor loads the one matching the process architecture before the
    first P/Invoke. It copies every engine the package carries, so it keeps no list of its own.

    Conditioned on the framework and on nothing else. An explicit PlatformTarget would let all but
    one copy be skipped, but AnyCPU - the default - has no architecture until the process starts,
    so there would still have to be a run-time choice. One path for every Framework consumer is
    worth more than the few megabytes the other copies cost.
  -->
  <Target Name="CopyArmoniKNativeEngines" BeforeTargets="AssignTargetPaths"
          Condition="'$(TargetFrameworkIdentifier)' == '.NETFramework'">
    <ItemGroup>
      <_ArmoniKNativeEngine Include="$(MSBuildThisFileDirectory)..\runtimes\win-*\native\armonik_transport_ffi.dll" />
      <!-- runtimes\win-<arch>\native\<library>: the folder two levels up, past its `win-`. -->
      <None Include="@(_ArmoniKNativeEngine)"
            Link="$([System.IO.Path]::GetFileName($([System.IO.Path]::GetDirectoryName($([System.IO.Path]::GetDirectoryName('%(_ArmoniKNativeEngine.FullPath)'))))).Substring(4))\armonik_transport_ffi.dll"
            CopyToOutputDirectory="PreserveNewest"
            Visible="false" />
    </ItemGroup>
  </Target>

  <!--
    The build of the engine with its counters, in the package's runtimes/<rid>/metrics folders, which
    no package manager reads native assets from: .NET Framework gets it in a folder of its own beside
    the first, named for the architecture, and .NET in the package's own layout, where
    NativeLibrarySelection looks for it. Every project that references the package gets it, since
    which build a process loads is decided when it runs.
  -->
  <Target Name="CopyArmoniKNativeMetricsEngines" BeforeTargets="AssignTargetPaths">
    <ItemGroup>
      <_ArmoniKNativeMetricsEngine Include="$(MSBuildThisFileDirectory)..\runtimes\*\metrics\*" />
      <None Include="@(_ArmoniKNativeMetricsEngine)"
            Condition="'$(TargetFrameworkIdentifier)' != '.NETFramework'"
            Link="runtimes\%(_ArmoniKNativeMetricsEngine.RecursiveDir)%(Filename)%(Extension)"
            CopyToOutputDirectory="PreserveNewest"
            CopyToPublishDirectory="PreserveNewest"
            Visible="false" />
      <!-- runtimes\win-<arch>\metrics\: the folder past its `win-`. -->
      <None Include="@(_ArmoniKNativeMetricsEngine)"
            Condition="'$(TargetFrameworkIdentifier)' == '.NETFramework' AND $([System.String]::Copy('%(_ArmoniKNativeMetricsEngine.RecursiveDir)').StartsWith('win-'))"
            Link="$([System.String]::Copy('%(_ArmoniKNativeMetricsEngine.RecursiveDir)').Substring(4))%(Filename)%(Extension)"
            CopyToOutputDirectory="PreserveNewest"
            Visible="false" />
    </ItemGroup>
  </Target>

</Project>
