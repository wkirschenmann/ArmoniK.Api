<Project>

  <!--
    Imported into the consumer's build, which is why its conditions can ask what the consumer is.

    .NET resolves a native asset by runtime identifier out of runtimes/<rid>/native, so it needs
    nothing from here. .NET Framework has no such mechanism at all: no deps.json, no runtime
    identifier, just the Win32 search order. So every Windows engine the package carries is copied
    beside the application, in a folder named for its architecture - win-x64 into x64 - and the
    binding's own static constructor loads the one matching the process architecture before the
    first P/Invoke. It copies every engine the package carries, so it keeps no list of its own,
    and beside it the CPU probe the binding asks whether the CPU runs x86-64-v4, where one is
    packed.

    Conditioned on the framework and on nothing else. An explicit PlatformTarget would let all but
    one copy be skipped, but AnyCPU - the default - has no architecture until the process starts,
    so there would still have to be a run-time choice. One path for every Framework consumer is
    worth more than the few megabytes the other copies cost.
  -->
  <Target Name="CopyArmoniKNativeEngines" BeforeTargets="AssignTargetPaths"
          Condition="'$(TargetFrameworkIdentifier)' == '.NETFramework'">
    <ItemGroup>
      <_ArmoniKNativeEngine Include="$(MSBuildThisFileDirectory)..\runtimes\win-*\native\armonik_transport_ffi.dll;$(MSBuildThisFileDirectory)..\runtimes\win-*\native\armonik_cpu_probe.dll" />
      <!-- runtimes\win-<arch>\native\<library>: the folder two levels up, past its `win-`. -->
      <None Include="@(_ArmoniKNativeEngine)"
            Link="$([System.IO.Path]::GetFileName($([System.IO.Path]::GetDirectoryName($([System.IO.Path]::GetDirectoryName('%(_ArmoniKNativeEngine.FullPath)'))))).Substring(4))\%(_ArmoniKNativeEngine.Filename)%(_ArmoniKNativeEngine.Extension)"
            CopyToOutputDirectory="PreserveNewest"
            Visible="false" />
    </ItemGroup>
  </Target>

  <!--
    The builds outside runtimes/<rid>/native, which no package manager reads native assets from: the
    engine with its counters in runtimes/<rid>/metrics, and for x64 each of the two compiled for
    x86-64-v4, in runtimes/<rid>/x86-64-v4 and runtimes/<rid>/metrics/x86-64-v4. .NET gets them in
    the package's own layout, where NativeLibrarySelection looks for them, and .NET Framework the
    Windows ones in the same folders under the one named for the architecture: x64\metrics,
    x64\x86-64-v4 and x64\metrics\x86-64-v4. A .NET consumer before net8.0 copies them unused,
    since the binding's netstandard2.0 build loads neither there. Every project that references the
    package gets them, since which build a process loads is decided when it runs.
  -->
  <Target Name="CopyArmoniKNativeEngineBuilds" BeforeTargets="AssignTargetPaths">
    <ItemGroup>
      <_ArmoniKNativeEngineBuild Include="$(MSBuildThisFileDirectory)..\runtimes\*\metrics\**;$(MSBuildThisFileDirectory)..\runtimes\*\x86-64-v4\*" />
      <None Include="@(_ArmoniKNativeEngineBuild)"
            Condition="'$(TargetFrameworkIdentifier)' != '.NETFramework'"
            Link="runtimes\%(_ArmoniKNativeEngineBuild.RecursiveDir)%(Filename)%(Extension)"
            CopyToOutputDirectory="PreserveNewest"
            CopyToPublishDirectory="PreserveNewest"
            Visible="false" />
      <!-- runtimes\win-<arch>\<folders>\: the folders past its `win-`. -->
      <None Include="@(_ArmoniKNativeEngineBuild)"
            Condition="'$(TargetFrameworkIdentifier)' == '.NETFramework' AND $([System.String]::Copy('%(_ArmoniKNativeEngineBuild.RecursiveDir)').StartsWith('win-'))"
            Link="$([System.String]::Copy('%(_ArmoniKNativeEngineBuild.RecursiveDir)').Substring(4))%(Filename)%(Extension)"
            CopyToOutputDirectory="PreserveNewest"
            Visible="false" />
    </ItemGroup>
  </Target>

</Project>
