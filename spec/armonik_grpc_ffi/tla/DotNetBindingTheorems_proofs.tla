                        \/ WriteDoneCompletes(c2)
                        \/ CloseWriter(c2)
                        \/ OnEventReturns(c2)
                        \/ TerminalCallbackReturns(c2)
                 PROVE  \/ (reader_state[cId] = "parsing_cancelled")'
                        \/ <<FinishCancelledParse(cId)>>_vars
      BY <1>6
