  <2>10. CASE ConsumeHeader(c2)
          BY <2>0, <2>10, SMT DEF  ConsumeHeader, RingTail, ManagedTypeOK,
           RuntimeDisposeStates, ManagedStutter, vars, l1_vars, managed_vars,
