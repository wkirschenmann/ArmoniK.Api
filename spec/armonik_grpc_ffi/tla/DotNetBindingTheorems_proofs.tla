<1>6. CASE \E cId \in CallIds :
             \/ BeginMoveNext(cId)
             \/ BeginParseEvent(cId)
             \/ FinishConsumePayload(cId)
             \/ CancelWaiter(cId)
             \/ RequestReadCancellation(cId)
             \/ CancelWaitingRead(cId)
             \/ CancelParsingRead(cId)
