    PROVE  (ManagedTypeOK /\ ManagedMachineInv /\ ManagedGlue)'
    <1> USE DEF ManagedIndInv, ManagedTypeOK, ManagedMachineInv,
           ReaderInv, LifecycleInv, ManagedGlue,
           ConsumerPhaseMatchesDispose, AtMostOneReaderOutstanding,
