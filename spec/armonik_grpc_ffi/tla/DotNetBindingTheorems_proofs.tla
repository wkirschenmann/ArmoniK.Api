                           BeginMoveNext(c2)
                        \/ BeginParseEvent(c2)
                        \/ FinishConsumePayload(c2)
                        \/ CancelWaiter(c2)
                        \/ RequestReadCancellation(c2)
                        \/ CancelWaitingRead(c2)
                        \/ CancelParsingRead(c2)
                        \/ FinishCancelledParse(c2)
